# Public Solana RPC used by the browser for optional on-chain risk attestations.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# RPC used by the token scanner for real mainnet mints.
SOLANA_MAINNET_RPC=https://solana-rpc.publicnode.com

# Pyth Pro: keep server-side only.
PYTH_PRO_API_KEY=
# Numeric Pyth Pro feed ID for the underlying equity (optional).
PYTH_PRO_FEED_ID=
PYTH_PRO_CHANNEL=fixed_rate@200ms 

#https://pyth.dourolabs.app/v1/symbols
# SWAT connectivity. The status route verifies openapi.json.
SWAT_BASE_URL=https://bitcoiners.norug.es
SWAT_API_KEY=
# Optional relative endpoint accepting ?asset=<mint-or-symbol> and returning a JSON risk payload.
SWAT_ASSET_RISK_PATH=/api/solana/meteora/token/{mint}/launch-risk

# StockShield-owned Meteora accounts. Keep blank until verifiable on-chain.
METEORA_NORMAL_CONFIG=
METEORA_DEFENSIVE_CONFIG=
METEORA_POOL_ADDRESS=
